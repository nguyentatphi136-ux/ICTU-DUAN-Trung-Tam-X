# =====================================================================
# Git Ignore - Hệ Thống Quản Lý Đào Tạo Trung Tâm (EMS)
# =====================================================================

# 1. Maven & Java Build Output
target/
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar

# 2. Node & Frontend dependencies
node_modules/
dist/
dist-ssr/
*.local
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 3. Environment & Secrets
.env
.env.production

# 4. IDE & Editors
.idea/
*.iml
*.iws
*.ipr
.settings/
.project
.classpath
*.sublime-project
*.sublime-workspace

# 5. OS & Temporary files
.DS_Store
Thumbs.db
ehthumbs.db
*.tmp
*.bak
*.swp
*~

# 6. Logs & Crash reports
*.log
hs_err_pid*
replay_pid*
