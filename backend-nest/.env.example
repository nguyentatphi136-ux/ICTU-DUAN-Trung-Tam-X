# Sao chép thành backend-nest/.env rồi sửa theo máy của bạn. File .env không được commit.

# Cổng của backend NestJS. 8080 thường dành cho backend Java.
PORT=3000

# MySQL, cùng CSDL ems_database với backend Java. Dạng mysql://user:mật_khẩu@máy:cổng/tên_csdl
DATABASE_URL=mysql://root@localhost:3306/ems_database

# Mật khẩu của các tài khoản thử trong src/auth/demo-accounts.ts (không dùng khi NODE_ENV=production)
DEMO_PASSWORD=123456
