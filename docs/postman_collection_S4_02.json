        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"classId\": 2,\n  \"instructorId\": 3,\n  \"roomId\": 1,\n  \"startDateTime\": \"2026-11-01T09:00:00\",\n  \"endDateTime\": \"2026-11-01T11:30:00\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/schedules/15",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "schedules", "15"]
