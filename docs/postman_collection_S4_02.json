{
  "info": {
    "name": "EMS - S4-02 Thời khóa biểu & Kiểm tra xung đột",
    "_postman_id": "s4-02-schedule-conflicts",
    "description": "Bộ kịch bản kiểm thử API cho User Story S4-02: Kiểm tra trùng giảng viên, trùng phòng, chặn lưu lịch, cơ chế ghi đè của QLĐT có audit log.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Kiểm tra xung đột (Không có xung đột)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"classId\": 1,\n  \"instructorId\": 3,\n  \"roomId\": 1,\n  \"startDateTime\": \"2026-11-01T07:00:00\",\n  \"endDateTime\": \"2026-11-01T09:00:00\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/schedules/check-conflicts",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "schedules", "check-conflicts"]
        }
      }
    },
    {
      "name": "2. Kiểm tra xung đột (Phát hiện trùng lịch giảng viên / phòng)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"classId\": 1,\n  \"instructorId\": 3,\n  \"roomId\": 1,\n  \"startDateTime\": \"2026-11-01T09:30:00\",\n  \"endDateTime\": \"2026-11-01T10:30:00\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/schedules/check-conflicts",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "schedules", "check-conflicts"]
        }
      }
    },
    {
      "name": "3. Tạo lịch học hợp lệ (HTTP 201 Created)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"classId\": 1,\n  \"instructorId\": 3,\n  \"roomId\": 1,\n  \"startDateTime\": \"2026-11-01T13:00:00\",\n  \"endDateTime\": \"2026-11-01T15:00:00\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/schedules",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "schedules"]
        }
      }
    },
    {
      "name": "4. Tạo lịch học bị xung đột (Mặc định bị chặn - HTTP 409 Conflict)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"classId\": 1,\n  \"instructorId\": 3,\n  \"roomId\": 1,\n  \"startDateTime\": \"2026-11-01T09:30:00\",\n  \"endDateTime\": \"2026-11-01T10:30:00\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/schedules",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "schedules"]
        }
      }
    },
    {
      "name": "5. Quản lý đào tạo xác nhận ghi đè có lý do (HTTP 201 Created)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"classId\": 1,\n  \"instructorId\": 3,\n  \"roomId\": 1,\n  \"startDateTime\": \"2026-11-01T09:30:00\",\n  \"endDateTime\": \"2026-11-01T10:30:00\",\n  \"overrideConflict\": true,\n  \"overrideReason\": \"Giảng viên thỏa thuận dạy ghép bù theo phê duyệt BGD\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/schedules",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "schedules"]
        }
      }
    },
    {
      "name": "6. Tra cứu danh sách thời khóa biểu",
      "request": {
        "method": "GET",
        "url": {
          "raw": "http://localhost:8080/api/schedules?fromDate=2026-11-01&toDate=2026-11-30",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "schedules"],
          "query": [
            { "key": "fromDate", "value": "2026-11-01" },
            { "key": "toDate", "value": "2026-11-30" }
          ]
        }
      }
    },
    {
      "name": "7. Chi tiết buổi học theo ID",
      "request": {
        "method": "GET",
        "url": {
          "raw": "http://localhost:8080/api/schedules/15",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "schedules", "15"]
        }
      }
    },
    {
      "name": "8. Cập nhật buổi học",
      "request": {
        "method": "PUT",
        "header": [
