    {
      "name": "9. Hủy buổi học",
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "http://localhost:8080/api/schedules/15?reason=Nghỉ lễ",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "schedules", "15"],
          "query": [
            { "key": "reason", "value": "Nghỉ lễ" }
          ]
