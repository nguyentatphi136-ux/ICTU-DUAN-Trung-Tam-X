{
  "openapi": "3.0.3",
  "info": {
    "title": "Education Management System - Training Program API",
    "description": "API RESTful quản lý danh mục chương trình đào tạo (User Story S2-04 / EP-02). Hỗ trợ CRUD, kiểm soát trùng mã, ràng buộc lớp học đang chạy, phân quyền theo vai trò (TrainingManager, Admin).",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080/ems",
      "description": "Local Tomcat Server"
    },
    {
      "url": "http://localhost:8080",
      "description": "Root Context Server"
    }
  ],
  "tags": [
    {
      "name": "Training Programs",
      "description": "Quản lý danh mục chương trình đào tạo (S2-04)"
    },
    {
      "name": "Subjects",
      "description": "Quản lý danh mục môn học (S2-05)"
    },
    {
      "name": "Curriculum",
      "description": "Gắn môn học vào chương trình và sắp thứ tự học (S2-06)"
    },
    {
      "name": "Sessions",
      "description": "Khai báo và nhân bản buổi học trong môn (S2-07)"
    },
    {
      "name": "Leads",
      "description": "Quản lý phễu khách hàng tiềm năng và thông tin liên hệ"
    }
  ],
  "paths": {
    "/api/training-programs": {
      "get": {
        "tags": [
          "Training Programs"
        ],
        "summary": "Lấy danh sách chương trình đào tạo",
        "description": "Trả về danh sách chương trình đào tạo có hỗ trợ phân trang, tìm kiếm theo mã hoặc tên, và lọc theo trạng thái.",
        "parameters": [
          {
            "name": "keyword",
            "in": "query",
            "description": "Từ khóa tìm kiếm theo mã (code) hoặc tên (name)",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "description": "Lọc theo trạng thái (ACTIVE, INACTIVE, ALL)",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "ACTIVE",
                "INACTIVE",
                "ALL"
              ],
              "default": "ALL"
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Số trang (bắt đầu từ 1)",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "description": "Số bản ghi trên mỗi trang",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lấy danh sách thành công",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrainingProgramPageResponse"
                }
              }
            }
          },
          "401": {
            "description": "Chưa đăng nhập / Phiên hết hạn"
          },
          "403": {
            "description": "Không có quyền truy cập (Yêu cầu vai trò TrainingManager hoặc Admin)"
          }
        }
      },
      "post": {
        "tags": [
          "Training Programs"
        ],
        "summary": "Tạo mới chương trình đào tạo",
        "description": "Tạo mới một chương trình đào tạo. Mã chương trình phải là duy nhất.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TrainingProgramCreateRequest"
              },
              "example": {
                "code": "JAVA-WEB",
                "name": "Java Web Chuyên nghiệp",
                "description": "Chương trình đào tạo Java Web Backend",
                "duration": 240,
                "standardTuition": 15000000,
                "status": "ACTIVE"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Tạo thành công",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrainingProgramSuccessResponse"
                }
              }
            }
          },
          "400": {
            "description": "Dữ liệu không hợp lệ (Code rỗng, duration <= 0, standardTuition < 0, ...)"
          },
          "409": {
            "description": "Mã chương trình đào tạo đã tồn tại (Conflict)"
          },
          "403": {
            "description": "Không có quyền thực hiện chức năng"
          }
        }
      }
    },
    "/api/training-programs/{id}": {
      "get": {
        "tags": [
          "Training Programs"
        ],
        "summary": "Lấy thông tin chi tiết chương trình đào tạo",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID chương trình đào tạo",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lấy chi tiết thành công",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrainingProgramSuccessResponse"
                }
              }
            }
          },
          "404": {
            "description": "Không tìm thấy chương trình đào tạo"
          }
        }
      },
      "put": {
        "tags": [
          "Training Programs"
        ],
        "summary": "Cập nhật chương trình đào tạo",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID chương trình đào tạo cần cập nhật",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TrainingProgramCreateRequest"
              },
              "example": {
                "code": "JAVA-WEB-PRO",
                "name": "Java Web Nâng Cao",
                "description": "Chương trình chuyên sâu Spring Boot và Microservices",
                "duration": 300,
                "standardTuition": 18000000,
                "status": "ACTIVE"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cập nhật thành công",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrainingProgramSuccessResponse"
                }
              }
            }
          },
          "400": {
            "description": "Dữ liệu không hợp lệ"
          },
          "404": {
            "description": "Không tìm thấy chương trình đào tạo"
          },
          "409": {
            "description": "Mã chương trình đào tạo bị trùng với chương trình khác"
          }
        }
      },
      "delete": {
        "tags": [
          "Training Programs"
        ],
        "summary": "Xoá chương trình đào tạo",
        "description": "Chỉ cho phép xoá nếu chương trình KHÔNG CÓ lớp học đang chạy (IN_PROGRESS, RUNNING, ACTIVE). Nếu có lớp đang chạy, hệ thống trả về HTTP 409 Conflict.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID chương trình đào tạo",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Xoá thành công"
          },
          "404": {
            "description": "Không tìm thấy chương trình đào tạo"
          },
          "409": {
            "description": "Không thể xoá vì đang có lớp học đang chạy (RULE 6)"
          }
        }
      }
    },
    "/api/training-programs/{id}/deactivate": {
      "patch": {
        "tags": [
          "Training Programs"
        ],
        "summary": "Ngừng áp dụng chương trình đào tạo",
        "description": "Chuyển trạng thái chương trình sang INACTIVE. Không xoá dữ liệu khỏi database.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID chương trình đào tạo",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ngừng áp dụng thành công",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrainingProgramSuccessResponse"
                }
              }
            }
          },
          "404": {
            "description": "Không tìm thấy chương trình đào tạo"
          }
        }
      }
    },
    "/api/leads": {
      "get": {
        "tags": [
          "Leads"
        ],
        "summary": "Lấy danh sách khách hàng tiềm năng (có tìm kiếm, lọc & phân trang)",
        "description": "Cho phép Tư vấn tuyển sinh, Quản lý đào tạo và Admin tra cứu danh sách lead theo từ khóa, trạng thái, nguồn, người phụ trách và khoảng thời gian.",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "description": "Từ khóa tìm kiếm theo họ tên, số điện thoại hoặc email",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "description": "Lọc theo trạng thái lead (NEW, CONTACTED, CONSULTING, TRIAL, WON, LOST, ENROLLED)",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "NEW",
                "CONTACTED",
                "CONSULTING",
                "TRIAL",
                "WON",
                "LOST",
                "ENROLLED",
                "ALL"
              ]
            }
          },
          {
            "name": "source",
            "in": "query",
            "description": "Lọc theo nguồn (WEBSITE, FACEBOOK, REFERRAL, DIRECT, ADS, EVENT, OTHER)",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "assignedTo",
            "in": "query",
            "description": "ID nhân sự tư vấn phụ trách",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "startDate",
            "in": "query",
            "description": "Ngày bắt đầu lọc (YYYY-MM-DD)",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "endDate",
            "in": "query",
            "description": "Ngày kết thúc lọc (YYYY-MM-DD)",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Số trang (bắt đầu từ 1)",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "description": "Số lượng bản ghi trên một trang (tối đa 100)",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lấy danh sách lead thành công",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LeadListResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      },
      "post": {
        "tags": [
          "Leads"
        ],
        "summary": "Tạo mới khách hàng tiềm năng",
        "description": "Thêm một lead mới vào hệ thống. Hệ thống tự động kiểm tra trùng lặp số điện thoại (trả về 409 Conflict nếu đã tồn tại). Hỗ trợ Admissions, TrainingManager, Admin.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateLeadRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Tạo lead mới thành công",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LeadDetailResponse"
                }
              }
            }
          },
          "400": {
            "description": "Dữ liệu validation không hợp lệ",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          },
          "409": {
            "description": "Trùng lặp số điện thoại trong hệ thống",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DuplicatePhoneResponse"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/api/leads/{id}": {
      "get": {
        "tags": [
          "Leads"
        ],
        "summary": "Xem thông tin chi tiết một khách hàng tiềm năng",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID của Lead cần xem",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lấy chi tiết lead thành công",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LeadDetailResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          },
          "404": {
            "description": "Không tìm thấy lead với ID tương ứng",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Leads"
        ],
        "summary": "Cập nhật thông tin khách hàng tiềm năng",
        "description": "Cập nhật họ tên, điện thoại, email, nguồn, chương trình quan tâm, trạng thái, ghi chú. Kiểm tra trùng lặp số điện thoại nếu thay đổi số. Hỗ trợ Admissions, TrainingManager, Admin.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID của Lead cần cập nhật",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateLeadRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cập nhật lead thành công",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LeadDetailResponse"
                }
              }
            }
          },
          "400": {
            "description": "Dữ liệu validation không hợp lệ",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          },
          "404": {
            "description": "Không tìm thấy lead với ID tương ứng",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Số điện thoại cập nhật bị trùng với lead khác",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DuplicatePhoneResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Leads"
        ],
        "summary": "Xóa khách hàng tiềm năng",
        "description": "Xóa hoàn toàn lead khỏi hệ thống. **CHỈ Quản lý đào tạo (Training Manager) và Admin mới có quyền xóa. Tư vấn tuyển sinh (Admissions) sẽ bị từ chối với mã 403 Forbidden.**",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID của Lead cần xóa",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Xóa lead thành công",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteLeadResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "description": "Bị từ chối truy cập (Ví dụ: Admissions cố tình gọi xóa)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Không tìm thấy lead cần xóa",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/leads/check-phone": {
      "get": {
        "tags": [
          "Leads"
        ],
        "summary": "Kiểm tra số điện thoại trùng lặp trước khi gửi form",
        "description": "Phục vụ frontend kiểm tra realtime khi người dùng nhập số điện thoại trong biểu mẫu tạo/sửa lead.",
        "parameters": [
          {
            "name": "phone",
            "in": "query",
            "required": true,
            "description": "Số điện thoại cần kiểm tra",
            "schema": {
              "type": "string",
              "example": "0912345678"
            }
          },
          {
            "name": "excludeId",
            "in": "query",
            "required": false,
            "description": "ID của lead hiện tại đang sửa (bỏ qua khi kiểm tra trùng)",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Kiểm tra số điện thoại thành công",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PhoneCheckResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequestError"
          }
        }
      }
    },
    "/api/subjects": {
      "get": {
        "tags": ["Subjects"],
        "summary": "Lấy danh sách môn học",
        "description": "Lấy danh sách môn học có phân trang và tìm kiếm theo mã, tên.",
        "responses": {
          "200": { "description": "Lấy danh sách môn học thành công" }
        }
      },
      "post": {
        "tags": ["Subjects"],
        "summary": "Tạo mới môn học (S2-05)",
        "description": "Khai báo mã, tên, số buổi, trọng số, chuẩn đầu ra. Mã môn là duy nhất.",
        "responses": {
          "201": { "description": "Tạo môn học thành công" },
          "409": { "description": "Mã môn học đã tồn tại" }
        }
      }
    },
    "/api/subjects/{id}": {
      "get": {
        "tags": ["Subjects"],
        "summary": "Chi tiết môn học",
        "responses": {
          "200": { "description": "Thành công" },
          "404": { "description": "Không tìm thấy môn học" }
        }
      },
      "put": {
        "tags": ["Subjects"],
        "summary": "Cập nhật môn học",
        "responses": {
          "200": { "description": "Cập nhật thành công" }
        }
      },
      "delete": {
        "tags": ["Subjects"],
        "summary": "Xoá môn học",
        "description": "Môn đã có lớp học thì không xoá được (trả về 409 Conflict).",
        "responses": {
          "200": { "description": "Xoá thành công" },
          "409": { "description": "Môn đã có lớp học nên không xoá được" }
        }
      }
    },
    "/api/programs/{programId}/subjects": {
      "get": {
        "tags": ["Curriculum"],
        "summary": "Lấy lộ trình môn học của chương trình (S2-06)",
        "responses": {
          "200": { "description": "Thành công" }
        }
      },
      "post": {
        "tags": ["Curriculum"],
        "summary": "Gắn môn học vào chương trình (S2-06)",
        "responses": {
          "201": { "description": "Gắn môn thành công" }
        }
      }
    },
    "/api/programs/{programId}/subjects/reorder": {
      "put": {
        "tags": ["Curriculum"],
        "summary": "Kéo thả sắp xếp thứ tự môn học trong chương trình (S2-06)",
        "description": "Thứ tự được lưu lại tự động.",
        "responses": {
          "200": { "description": "Lưu thứ tự môn học thành công" }
        }
      }
    },
    "/api/programs/{programId}/subjects/{subjectId}": {
      "delete": {
        "tags": ["Curriculum"],
        "summary": "Gỡ môn học khỏi chương trình (S2-06)",
        "responses": {
          "200": { "description": "Gỡ môn thành công" }
        }
      }
    },
    "/api/subjects/{subjectId}/sessions": {
      "get": {
        "tags": ["Sessions"],
        "summary": "Danh sách các buổi học của một môn (S2-07)",
        "responses": {
          "200": { "description": "Thành công" }
        }
      },
      "post": {
        "tags": ["Sessions"],
        "summary": "Thêm buổi học trong môn (S2-07)",
        "description": "Số buổi khai báo không vượt quá số buổi của môn học.",
        "responses": {
          "201": { "description": "Thêm buổi học thành công" },
          "409": { "description": "Đã đủ số buổi của môn học, không thể thêm" }
        }
      }
    },
    "/api/subjects/{subjectId}/sessions/clone": {
      "post": {
        "tags": ["Sessions"],
        "summary": "Nhân bản danh sách buổi từ môn khác (S2-07)",
        "responses": {
          "200": { "description": "Nhân bản thành công" }
        }
      }
    },
    "/api/subjects/{subjectId}/sessions/{sessionId}": {
      "put": {
        "tags": ["Sessions"],
        "summary": "Sửa buổi học",
        "responses": {
          "200": { "description": "Cập nhật thành công" }
        }
      },
      "delete": {
        "tags": ["Sessions"],
        "summary": "Xoá buổi học",
        "responses": {
          "200": { "description": "Xoá thành công" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "TrainingProgramCreateRequest": {
        "type": "object",
        "required": [
          "code",
          "name",
          "duration",
          "standardTuition"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Mã chương trình (duy nhất, không rỗng, tối đa 50 ký tự)",
            "example": "JAVA-WEB"
          },
          "name": {
            "type": "string",
            "description": "Tên chương trình đào tạo (tối đa 150 ký tự)",
            "example": "Lập trình Java Web"
          },
          "description": {
            "type": "string",
            "description": "Mô tả chương trình đào tạo",
            "example": "Khóa học đào tạo kỹ sư Java Backend"
          },
          "duration": {
            "type": "integer",
            "description": "Tổng thời lượng (> 0)",
            "example": 240
          },
          "standardTuition": {
            "type": "number",
            "format": "double",
            "description": "Học phí chuẩn (>= 0)",
            "example": 15000000
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "INACTIVE"
            ],
            "default": "ACTIVE",
            "description": "Trạng thái áp dụng"
          }
        }
      },
      "TrainingProgramResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "code": {
            "type": "string",
            "example": "JAVA-WEB"
          },
          "name": {
            "type": "string",
            "example": "Lập trình Java Web"
          },
          "description": {
            "type": "string",
            "example": "Khóa học đào tạo kỹ sư Java Backend"
          },
          "duration": {
            "type": "integer",
            "example": 240
          },
          "standardTuition": {
            "type": "number",
            "example": 15000000
          },
          "status": {
            "type": "string",
            "example": "ACTIVE"
          },
          "createdAt": {
            "type": "string",
            "example": "2026-10-04T14:00:00"
          },
          "updatedAt": {
            "type": "string",
            "example": "2026-10-04T14:00:00"
          }
        }
      },
      "TrainingProgramSuccessResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "code": {
            "type": "string",
            "example": "PROGRAM_CREATED"
          },
          "message": {
            "type": "string",
            "example": "Tạo mới chương trình đào tạo thành công."
          },
          "data": {
            "$ref": "#/components/schemas/TrainingProgramResponse"
          }
        }
      },
      "TrainingProgramPageResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "code": {
            "type": "string",
            "example": "PROGRAM_LIST_SUCCESS"
          },
          "message": {
            "type": "string",
            "example": "Lấy danh sách chương trình đào tạo thành công."
          },
          "data": {
            "type": "object",
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/TrainingProgramResponse"
                }
              },
              "total": {
                "type": "integer",
                "example": 25
              },
              "page": {
                "type": "integer",
                "example": 1
              },
              "pageSize": {
                "type": "integer",
                "example": 10
              },
              "totalPages": {
                "type": "integer",
                "example": 3
              }
            }
          }
        }
      },
      "Lead": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "fullName": {
            "type": "string",
            "example": "Trần Minh Quang"
          },
          "phone": {
            "type": "string",
            "example": "0912345678"
          },
          "email": {
            "type": "string",
            "example": "quang.tran@gmail.com"
          },
          "source": {
            "type": "string",
            "example": "WEBSITE"
          },
          "programId": {
            "type": "integer",
            "nullable": true,
            "example": 1
          },
          "programInterest": {
            "type": "string",
            "example": "Khóa học Lập trình Web Fullstack Java"
          },
          "status": {
            "type": "string",
            "example": "NEW"
          },
          "notes": {
            "type": "string",
            "example": "Quan tâm lớp học tối, cần tư vấn lộ trình"
          },
          "assignedTo": {
            "type": "integer",
            "nullable": true,
            "example": 5
          },
          "assignedToName": {
            "type": "string",
            "example": "Nguyễn Văn Kỳ"
          },
          "createdBy": {
            "type": "integer",
            "nullable": true,
            "example": 1
          },
          "createdByName": {
            "type": "string",
            "example": "Quản trị viên"
          },
          "updatedBy": {
            "type": "integer",
            "nullable": true,
            "example": 1
          },
          "updatedByName": {
            "type": "string",
            "example": "Quản trị viên"
          },
          "createdAt": {
            "type": "string",
            "example": "2026-10-03 20:00:00"
          },
          "updatedAt": {
            "type": "string",
            "example": "2026-10-03 20:30:00"
          }
        }
      },
      "CreateLeadRequest": {
        "type": "object",
        "required": [
          "fullName",
          "phone"
        ],
        "properties": {
          "fullName": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100,
            "example": "Nguyễn Hoàng Nam"
          },
          "phone": {
            "type": "string",
            "example": "0988776655"
          },
          "email": {
            "type": "string",
            "example": "nam.nguyen@example.com"
          },
          "source": {
            "type": "string",
            "default": "WEBSITE",
            "example": "FACEBOOK"
          },
          "programId": {
            "type": "integer",
            "example": 2
          },
          "programInterest": {
            "type": "string",
            "example": "Lập trình React Frontend"
          },
          "status": {
            "type": "string",
            "default": "NEW",
            "example": "NEW"
          },
          "notes": {
            "type": "string",
            "example": "Khách muốn tư vấn hình thức trả góp"
          },
          "assignedTo": {
            "type": "integer",
            "example": 3
          },
          "forceDuplicate": {
            "type": "boolean",
            "default": false,
            "description": "Nếu true, cho phép lưu dù trùng số điện thoại"
          }
        }
      },
      "UpdateLeadRequest": {
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string",
            "example": "Nguyễn Hoàng Nam"
          },
          "phone": {
            "type": "string",
            "example": "0988776655"
          },
          "email": {
            "type": "string",
            "example": "nam.nguyen@example.com"
          },
          "source": {
            "type": "string",
            "example": "FACEBOOK"
          },
          "programId": {
            "type": "integer",
            "example": 2
          },
          "programInterest": {
            "type": "string",
            "example": "Lập trình React Frontend"
          },
          "status": {
            "type": "string",
            "example": "CONTACTED"
          },
          "notes": {
            "type": "string",
            "example": "Đã gọi tư vấn, hẹn ngày mai liên hệ lại"
          },
          "assignedTo": {
            "type": "integer",
            "example": 3
          },
          "forceDuplicate": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "LeadListResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "code": {
            "type": "string",
            "example": "LEAD_LIST_SUCCESS"
          },
          "message": {
            "type": "string",
            "example": "Lấy danh sách khách hàng tiềm năng thành công."
          },
          "data": {
            "type": "object",
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Lead"
                }
              },
              "page": {
                "type": "integer",
                "example": 1
              },
              "pageSize": {
                "type": "integer",
                "example": 10
              },
              "totalItems": {
                "type": "integer",
                "example": 45
              },
              "totalPages": {
                "type": "integer",
                "example": 5
              }
            }
          }
        }
      },
      "LeadDetailResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "code": {
            "type": "string",
            "example": "LEAD_DETAIL_SUCCESS"
          },
          "message": {
            "type": "string",
            "example": "Thao tác khách hàng tiềm năng thành công."
          },
          "data": {
            "$ref": "#/components/schemas/Lead"
          }
        }
      },
      "DeleteLeadResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "code": {
            "type": "string",
            "example": "LEAD_DELETED"
          },
          "message": {
            "type": "string",
            "example": "Xóa khách hàng tiềm năng thành công."
          },
          "data": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "example": 5
              },
              "fullName": {
                "type": "string",
                "example": "Nguyễn Hoàng Nam"
              }
            }
          }
        }
      },
      "PhoneCheckResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "code": {
            "type": "string",
            "example": "PHONE_CHECK_SUCCESS"
          },
          "message": {
            "type": "string",
            "example": "Kiểm tra số điện thoại thành công."
          },
          "data": {
            "type": "object",
            "properties": {
              "phone": {
                "type": "string",
                "example": "0912345678"
              },
              "isDuplicate": {
                "type": "boolean",
                "example": true
              },
              "duplicateLead": {
                "$ref": "#/components/schemas/Lead"
              }
            }
          }
        }
      },
      "DuplicatePhoneResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "example": "DUPLICATE_PHONE"
              },
              "message": {
                "type": "string",
                "example": "Số điện thoại '0912345678' đã tồn tại trong hệ thống (Lead #1 - Trần Minh Quang)."
              },
              "duplicateLead": {
                "$ref": "#/components/schemas/Lead"
              },
              "action": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string",
                    "example": "Xem lead trùng"
                  },
                  "href": {
                    "type": "string",
                    "example": "/admissions.html?id=1"
                  }
                }
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "example": "LEAD_VALIDATION_ERROR"
              },
              "message": {
                "type": "string",
                "example": "Số điện thoại không đúng định dạng di động Việt Nam hợp lệ."
              },
              "action": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string",
                    "example": "Thử lại"
                  },
                  "href": {
                    "type": "string",
                    "example": "/admissions.html"
                  }
                }
              }
            }
          }
        }
      }
    },
    "responses": {
      "UnauthorizedError": {
        "description": "Chưa đăng nhập hoặc phiên làm việc đã hết hạn (401)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "ForbiddenError": {
        "description": "Không có quyền thực hiện thao tác (403)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "BadRequestError": {
        "description": "Yêu cầu không hợp lệ hoặc thiếu tham số bắt buộc (400)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "InternalServerError": {
        "description": "Lỗi máy chủ hoặc lỗi cơ sở dữ liệu (500/503)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    }
  }
