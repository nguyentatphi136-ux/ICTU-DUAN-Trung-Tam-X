# Sao chép thành backend/.env rồi sửa theo máy của bạn. File .env không được commit.
# Dòng nào bỏ trống thì dùng giá trị mặc định (src/main/resources/database.properties, cổng 8080).

# Cổng của backend. Frontend đặt VITE_API_URL=http://localhost:<PORT> trong frontend/.env.local.
PORT=8080

# Kết nối MySQL
DB_URL=jdbc:mysql://localhost:3306/ems_database?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&characterEncoding=UTF-8
DB_USER=root
DB_PASSWORD=

# true: mỗi lần khởi động, mọi tài khoản về mật khẩu mặc định Tms@2026 và được mở khoá (chỉ bật trên máy cá nhân).
# Bỏ trống hoặc false: giữ nguyên mật khẩu đã đổi.
# RESET_PASSWORDS_ON_START=true

# Gửi email (quên mật khẩu, kích hoạt tài khoản). Bỏ trống thì liên kết đặt lại mật khẩu được in ra terminal của backend.
# Gmail: SMTP_PASSWORD là "mật khẩu ứng dụng" (App Password), không phải mật khẩu đăng nhập.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=
# Địa chỉ frontend đặt trong liên kết email (mặc định http://localhost:5173)
# APP_BASE_URL=http://localhost:5173

# Thư mục JDK 17 trở lên, chỉ cần khi lệnh java trên máy không chạy được
# JAVA_HOME=C:\Program Files\Eclipse Adoptium\jdk-21
