# Sao chép thành backend/.env rồi sửa theo máy của bạn. File .env không được commit.
# Dòng nào bỏ trống thì dùng giá trị mặc định (src/main/resources/database.properties, cổng 8080).

# Cổng của backend. Frontend đặt VITE_API_URL=http://localhost:<PORT> trong frontend/.env.local.
PORT=8080

# Kết nối MySQL
DB_URL=jdbc:mysql://localhost:3306/ems_database?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&characterEncoding=UTF-8
DB_USER=root
DB_PASSWORD=

# Thư mục JDK 17 trở lên, chỉ cần khi lệnh java trên máy không chạy được
# JAVA_HOME=C:\Program Files\Eclipse Adoptium\jdk-21
